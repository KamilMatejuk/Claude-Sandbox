# Local sandbox config — copy to `.env` (gitignored) and edit.
# Sourced by sandbox.sh before its defaults are applied.
#
# Use the ${VAR:=default} form so anything you pass on the command line
# (e.g. `ALLOWED_PORTS="443 80" sandbox-claude`) still overrides this file.

# --- Corporate proxy for git-over-ssh (optional) ---
# If your ~/.ssh/config routes github through a proxy, allowlist the proxy host
# and open its port. Example for a proxy on port 912:
#
# : "${GIT_SSH_DOMAINS:=proxy.example.com ssh.github.com github.com}"
# : "${ALLOWED_PORTS:=443 80 22 912}"

# --- Extra always-on egress domains (optional) ---
# Space-separated. Added to the allowlist for every run (on top of the built-in
# Bedrock + pypi + git-over-ssh hosts).
# : "${ALLOWED_DOMAINS:=ci.example.com artifacts.example.com}"

# --- Auth (usually exported in your shell, but can live here) ---
# Pick ONE. The matching endpoint is allowlisted automatically.
#
# Amazon Bedrock:
# export AWS_BEARER_TOKEN_BEDROCK=...
# : "${AWS_REGION:=us-east-2}"
#
# Anthropic API:
# export ANTHROPIC_API_KEY=sk-ant-...
#
# Gateway / proxy (custom endpoint + token):
# export ANTHROPIC_AUTH_TOKEN=...
# export ANTHROPIC_BASE_URL=https://llm-gateway.example.com

# --- Model (optional) ---
# Defaults to Opus 4.8 for the active auth mode if unset. Bedrock requires the
# "anthropic." inference-profile prefix; the direct API / gateway uses the bare ID.
# : "${ANTHROPIC_MODEL:=anthropic.claude-opus-4-8}"   # Bedrock
# : "${ANTHROPIC_MODEL:=claude-opus-4-8}"             # direct API / gateway
